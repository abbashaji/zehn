fn range_sum(values: List<Int>, lo: Int, hi: Int) -> Int
  intent "sum of the values with index from lo up to and including hi"
  example range_sum([1, 2, 3, 4], 1, 2) == 5
  example range_sum([1, 2, 3], 0, 2) == 6
  example range_sum([1, 2, 3], 2, 1) == 0
do
  if lo > hi then
    return 0
  end if
  return option.unwrap_or(list.get(values, lo), 0) + range_sum(values, lo + 1, hi)
end fn

fn moving_from(values: List<Int>, window: Int, i: Int, done: List<Int>) -> List<Int>
  intent "append the sum of the last window values ending at index i, for every index from i on"
  example moving_from([], 2, 0, []) == []
  example moving_from([1, 2, 3], 2, 0, []) == [1, 3, 5]
do
  if i >= list.len(values) then
    return done
  end if
  return moving_from(values, window, i + 1, list.append(done, range_sum(values, int.max(0, i - window + 1), i)))
end fn

fn moving_sum(values: List<Int>, window: Int) -> Result<List<Int>, Text>
  intent "for each position the sum of the last window values (fewer at the start); window below 1 is an error"
  example moving_sum([1, 2, 3, 4], 2) == ok([1, 3, 5, 7])
  example moving_sum([5, -1, 2], 1) == ok([5, -1, 2])
  example moving_sum([1, 2, 3], 10) == ok([1, 3, 6])
  example moving_sum([1], 0) == err("invalid window")
do
  if window < 1 then
    return err("invalid window")
  end if
  return ok(moving_from(values, window, 0, []))
end fn
