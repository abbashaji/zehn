fn running_from(values: List<Int>, i: Int, total: Int, done: List<Int>) -> List<Int>
  intent "append the running total after each value from index i on"
  example running_from([], 0, 0, []) == []
  example running_from([1, 2, 3], 0, 0, []) == [1, 3, 6]
do
  match list.get(values, i) do
    case none =>
      return done
    case some(v) =>
      return running_from(values, i + 1, total + v, list.append(done, total + v))
  end match
end fn

fn moving_sum(values: List<Int>, window: Int) -> Result<List<Int>, Text>
  intent "running totals of the values; the window is not used yet"
  example moving_sum([1, 2, 3], 10) == ok([1, 3, 6])
  example moving_sum([], 3) == ok([])
do
  return ok(running_from(values, 0, 0, []))
end fn
