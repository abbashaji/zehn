  "params": [
    {
      "name": "staff",
      "type": "List<Employee>"
    },
    {
      "name": "dept",
      "type": "Option<Text>"
    }
  ],
  "returns": "Int",
  "types": [
    {
      "name": "Employee",
      "fields": [
        {
          "name": "name",
          "type": "Text"
        },
        {
          "name": "dept",
          "type": "Text"
        },
        {
          "name": "salary",
          "type": "Int"
        },
        {
          "name": "active",
          "type": "Bool"
        }
      ]
    }
  ],
  "effects": [],
