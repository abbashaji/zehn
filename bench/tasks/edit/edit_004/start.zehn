type Employee = { name: Text, dept: Text, salary: Int, active: Bool }

fn payroll_from(staff: List<Employee>, i: Int) -> Int
  intent "sum the salaries of active employees from index i on"
  example payroll_from([], 0) == 0
  example payroll_from([{name: "a", dept: "X", salary: 5, active: true}, {name: "b", dept: "X", salary: 9, active: false}], 0) == 5
do
  match list.get(staff, i) do
    case none =>
      return 0
    case some(e) =>
      if e.active then
        return e.salary + payroll_from(staff, i + 1)
      end if
      return payroll_from(staff, i + 1)
  end match
end fn

fn payroll_total(staff: List<Employee>, dept: Option<Text>) -> Int
  intent "total salary of active employees"
  example payroll_total([], none) == 0
  example payroll_total([{name: "a", dept: "X", salary: 5, active: true}], none) == 5
do
  return payroll_from(staff, 0)
end fn
