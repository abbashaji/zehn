fn merge_from(a: List<Int>, b: List<Int>, i: Int, j: Int, done: List<Int>) -> List<Int>
  intent "merge a from index i and b from index j into done, taking the smaller head"
  example merge_from([], [], 0, 0, []) == []
  example merge_from([1, 3], [2, 4], 0, 0, []) == [1, 2, 3, 4]
do
  match list.get(a, i) do
    case none =>
      match list.get(b, j) do
        case none =>
          return done
        case some(y) =>
          return merge_from(a, b, i, j + 1, list.append(done, y))
      end match
    case some(x) =>
      match list.get(b, j) do
        case none =>
          return done
        case some(y) =>
          if x < y then
            return merge_from(a, b, i + 1, j, list.append(done, x))
          end if
          if x > y then
            return merge_from(a, b, i, j + 1, list.append(done, y))
          end if
          return merge_from(a, b, i + 1, j + 1, list.append(list.append(done, x), y))
      end match
  end match
end fn

fn merge_unique(a: List<Int>, b: List<Int>) -> List<Int>
  intent "merge two ascending lists into one ascending list"
  example merge_unique([1, 3], [2, 4]) == [1, 2, 3, 4]
  example merge_unique([], []) == []
do
  return merge_from(a, b, 0, 0, [])
end fn
