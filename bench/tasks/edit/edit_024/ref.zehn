fn push_new(done: List<Int>, v: Int) -> List<Int>
  intent "append v to done unless it equals the last element of done"
  example push_new([], 3) == [3]
  example push_new([1, 3], 3) == [1, 3]
  example push_new([1, 3], 4) == [1, 3, 4]
do
  if list.len(done) == 0 then
    return list.append(done, v)
  end if
  match list.get(done, list.len(done) - 1) do
    case none =>
      return list.append(done, v)
    case some(last) =>
      if last == v then
        return done
      end if
      return list.append(done, v)
  end match
end fn

fn merge_from(a: List<Int>, b: List<Int>, i: Int, j: Int, done: List<Int>) -> List<Int>
  intent "merge a from index i and b from index j into done, taking the smaller head and skipping repeats"
  example merge_from([], [], 0, 0, []) == []
  example merge_from([1, 3], [2, 3], 0, 0, []) == [1, 2, 3]
  example merge_from([5, 6], [1], 0, 0, []) == [1, 5, 6]
do
  match list.get(a, i) do
    case none =>
      match list.get(b, j) do
        case none =>
          return done
        case some(y) =>
          return merge_from(a, b, i, j + 1, push_new(done, y))
      end match
    case some(x) =>
      match list.get(b, j) do
        case none =>
          return merge_from(a, b, i + 1, j, push_new(done, x))
        case some(y) =>
          if x <= y then
            return merge_from(a, b, i + 1, j, push_new(done, x))
          end if
          return merge_from(a, b, i, j + 1, push_new(done, y))
      end match
  end match
end fn

fn merge_unique(a: List<Int>, b: List<Int>) -> List<Int>
  intent "merge two ascending lists into one ascending list in which every value appears once"
  example merge_unique([1, 3], [2, 4]) == [1, 2, 3, 4]
  example merge_unique([1, 1, 2], [2, 2, 5]) == [1, 2, 5]
  example merge_unique([], [4, 4]) == [4]
do
  return merge_from(a, b, 0, 0, [])
end fn
