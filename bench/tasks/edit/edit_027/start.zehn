fn search(xs: List<Int>, target: Int, lo: Int, hi: Int) -> Option<Int>
  intent "binary search for target in the index range from lo to hi"
  example search([1, 3, 5], 3, 0, 2) == some(1)
  example search([1, 3, 5], 4, 0, 2) == none
do
  if lo >= hi then
    return none
  end if
  let mid = (lo + hi) / 2
  match list.get(xs, mid) do
    case none =>
      return none
    case some(v) =>
      if v == target then
        return some(mid)
      end if
      if v < target then
        return search(xs, target, mid + 1, hi)
      end if
      return search(xs, target, lo, mid - 1)
  end match
end fn

fn first_index(xs: List<Int>, target: Int) -> Option<Int>
  intent "index at which target occurs in the ascending list xs"
  example first_index([1, 3, 5, 7, 9], 7) == some(3)
  example first_index([1, 3, 5], 4) == none
do
  return search(xs, target, 0, list.len(xs) - 1)
end fn
