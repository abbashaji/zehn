fn lower_bound(xs: List<Int>, target: Int, lo: Int, hi: Int) -> Int
  intent "smallest index from lo up to hi whose value is not less than target, or hi when there is none"
  example lower_bound([1, 3, 5], 3, 0, 3) == 1
  example lower_bound([1, 3, 5], 9, 0, 3) == 3
  example lower_bound([2, 2, 2], 2, 0, 3) == 0
do
  if lo >= hi then
    return lo
  end if
  let mid = (lo + hi) / 2
  match list.get(xs, mid) do
    case none =>
      return lo
    case some(v) =>
      if v < target then
        return lower_bound(xs, target, mid + 1, hi)
      end if
      return lower_bound(xs, target, lo, mid)
  end match
end fn

fn first_index(xs: List<Int>, target: Int) -> Option<Int>
  intent "smallest index at which target occurs in the ascending list xs"
  example first_index([1, 3, 5, 7, 9], 7) == some(3)
  example first_index([1, 3, 5], 4) == none
  example first_index([2, 2, 2], 2) == some(0)
do
  let i = lower_bound(xs, target, 0, list.len(xs))
  match list.get(xs, i) do
    case none =>
      return none
    case some(v) =>
      if v == target then
        return some(i)
      end if
      return none
  end match
end fn
