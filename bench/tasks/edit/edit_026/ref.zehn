fn started_hours(minutes: Int) -> Int
  intent "number of started hours: 0 minutes is 0, 1 to 60 minutes is 1, and so on"
  example started_hours(0) == 0
  example started_hours(60) == 1
  example started_hours(61) == 2
do
  return (minutes + 59) / 60
end fn

fn block_fee(minutes: Int, rate: Int, cap: Int) -> Int
  intent "fee for a stay of less than one day: every started hour, never more than the cap"
  example block_fee(90, 200, 1000) == 400
  example block_fee(600, 200, 1000) == 1000
  example block_fee(0, 200, 1000) == 0
do
  return int.min(started_hours(minutes) * rate, cap)
end fn

fn parking_fee(minutes: Int, rate: Int, grace: Int, cap: Int) -> Result<Int, Text>
  intent "parking fee in cents with a free grace time and a cap per 24 hour block"
  ensures result.is_ok(out) implies result.unwrap(out) >= 0
  example parking_fee(90, 200, 15, 5000) == ok(400)
  example parking_fee(10, 200, 15, 5000) == ok(0)
  example parking_fee(1500, 200, 15, 1000) == ok(1200)
  example parking_fee(-5, 200, 15, 1000) == err("invalid duration")
do
  if minutes < 0 then
    return err("invalid duration")
  end if
  if rate < 0 then
    return err("invalid rate")
  end if
  if grace < 0 or cap < 0 then
    return err("invalid limit")
  end if
  if minutes <= grace then
    return ok(0)
  end if
  let days = minutes / 1440
  let rest = minutes % 1440
  return ok(days * int.min(24 * rate, cap) + block_fee(rest, rate, cap))
end fn
