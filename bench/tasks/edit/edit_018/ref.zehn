fn part(parts: List<Int>, i: Int) -> Int
  intent "component i of a version, 0 when the version has no such component"
  example part([1, 2], 0) == 1
  example part([1, 2], 5) == 0
do
  return option.unwrap_or(list.get(parts, i), 0)
end fn

fn compare_from(a: List<Int>, b: List<Int>, i: Int, n: Int) -> Int
  intent "compare component by component from index i up to n components: -1, 0 or 1"
  example compare_from([1], [1], 0, 1) == 0
  example compare_from([1, 2], [1, 3], 0, 2) == -1
  example compare_from([2], [1, 5], 0, 2) == 1
  example compare_from([1], [1, 0, 0], 0, 3) == 0
do
  if i >= n then
    return 0
  end if
  let x = part(a, i)
  let y = part(b, i)
  if x < y then
    return -1
  end if
  if x > y then
    return 1
  end if
  return compare_from(a, b, i + 1, n)
end fn

fn compare_versions(a: List<Int>, b: List<Int>) -> Int
  intent "-1 when version a is older than b, 0 when they are the same, 1 when a is newer; missing components count as 0"
  example compare_versions([1, 2], [1, 3]) == -1
  example compare_versions([1, 2, 0], [1, 2]) == 0
  example compare_versions([3, 0], [1, 9]) == 1
do
  return compare_from(a, b, 0, int.max(list.len(a), list.len(b)))
end fn
