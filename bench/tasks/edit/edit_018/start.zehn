fn compare_from(a: List<Int>, b: List<Int>, i: Int) -> Int
  intent "compare component by component from index i; the longer version is newer when one is a prefix of the other"
  example compare_from([1], [1], 0) == 0
  example compare_from([1, 2], [1, 3], 0) == -1
  example compare_from([1], [1, 5], 0) == -1
do
  match list.get(a, i) do
    case none =>
      match list.get(b, i) do
        case none =>
          return 0
        case some(y) =>
          return -1
      end match
    case some(x) =>
      match list.get(b, i) do
        case none =>
          return 1
        case some(y) =>
          if x == y then
            return compare_from(a, b, i + 1)
          end if
          return x - y
      end match
  end match
end fn

fn compare_versions(a: List<Int>, b: List<Int>) -> Int
  intent "compare two versions component by component"
  example compare_versions([1, 2], [1, 3]) == -1
  example compare_versions([1, 4], [1, 4]) == 0
do
  return compare_from(a, b, 0)
end fn
