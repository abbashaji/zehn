fn zero_from(values: List<Int>, i: Int, sum: Int, firsts: Map<Int, Int>, best: Int) -> Int
  intent "longest zero-sum block seen so far (best), extended by blocks that end at an index from i on; sum is the total of the elements before i and firsts maps every prefix total to the first prefix length that had it"
  requires i >= 0
  example zero_from([1, -1], 0, 0, map.set(map.empty(), 0, 0), 0) == 2
  example zero_from([3, 4], 0, 0, map.set(map.empty(), 0, 0), 0) == 0
  example zero_from([], 0, 0, map.empty(), 6) == 6
do
  match list.get(values, i) do
    case none =>
      return best
    case some(x) =>
      let total = sum + x
      match map.get(firsts, total) do
        case none =>
          return zero_from(values, i + 1, total, map.set(firsts, total, i + 1), best)
        case some(j) =>
          return zero_from(values, i + 1, total, firsts, int.max(best, i + 1 - j))
      end match
  end match
end fn

fn longest_zero_sum(values: List<Int>) -> Int
  intent "length of the longest block of consecutive elements that adds up to 0; 0 when there is none"
  ensures out >= 0
  ensures out <= list.len(values)
  example longest_zero_sum([1, -1, 3]) == 2
  example longest_zero_sum([3, 4]) == 0
  example longest_zero_sum([]) == 0
do
  return zero_from(values, 0, 0, map.set(map.empty(), 0, 0), 0)
end fn
