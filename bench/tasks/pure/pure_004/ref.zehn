fn kth_merged(a: List<Int>, i: Int, b: List<Int>, j: Int, k: Int) -> Option<Int>
  intent "the element at position k of the merge of a[i..] and b[j..], both ascending; none if there are not enough elements"
  requires i >= 0
  requires j >= 0
  requires k >= 0
  example kth_merged([1, 3], 0, [2], 0, 1) == some(2)
  example kth_merged([1, 3], 0, [2], 0, 3) == none
  example kth_merged([], 0, [4, 6], 0, 1) == some(6)
do
  match list.get(a, i) do
    case none =>
      return list.get(b, j + k)
    case some(x) =>
      match list.get(b, j) do
        case none =>
          return list.get(a, i + k)
        case some(y) =>
          if x <= y then
            if k == 0 then
              return some(x)
            else
              return kth_merged(a, i + 1, b, j, k - 1)
            end if
          else
            if k == 0 then
              return some(y)
            else
              return kth_merged(a, i, b, j + 1, k - 1)
            end if
          end if
      end match
  end match
end fn

fn merged_median(a: List<Int>, b: List<Int>) -> Option<Int>
  intent "lower median of the merge of two ascending lists; none when both are empty"
  example merged_median([1, 3], [2]) == some(2)
  example merged_median([1, 2], [3, 4]) == some(2)
  example merged_median([], []) == none
do
  let total = list.len(a) + list.len(b)
  if total == 0 then
    return none
  else
    return kth_merged(a, 0, b, 0, (total - 1) / 2)
  end if
end fn
