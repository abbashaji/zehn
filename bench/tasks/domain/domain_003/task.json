{
  "id": "domain_003",
  "category": "domain",
  "level": 2,
  "kind": "write",
  "title": "Book a seat with a per-guest limit",
  "description": "A small hall has a list of seats. Each seat has a label and a holder, which is either nobody or the name of the guest who booked it. Seat labels are unique and compared exactly. Write book_seat, which takes the list, a seat label and a guest name and returns the new list: the same seats in the same order, with the named seat now held by the guest. Checks happen in this order, and the first failing one decides the result: an empty guest name gives the error \"guest name required\"; a label that matches no seat gives \"no such seat: \" followed by the label; a seat that already has a holder (even the same guest) gives \"seat already booked: \" followed by the label; a guest who already holds two or more seats gives \"booking limit reached for \" followed by the guest name. A guest may therefore hold at most two seats.",
  "entry": "book_seat",
  "params": [
    {
      "name": "seats",
      "type": "List<Seat>"
    },
    {
      "name": "label",
      "type": "Text"
    },
    {
      "name": "guest",
      "type": "Text"
    }
  ],
  "returns": "Result<List<Seat>, Text>",
  "types": [
    {
      "name": "Seat",
      "fields": [
        {
          "name": "label",
          "type": "Text"
        },
        {
          "name": "holder",
          "type": "Option<Text>"
        }
      ]
    }
  ],
