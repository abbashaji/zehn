type Cmd = { op: Text, n: Int }

fn take_from(xs: List<Int>, i: Int, k: Int, acc: List<Int>) -> List<Int>
  intent "the first k items of xs, appended to acc by walking from index i"
  requires i >= 0
  example take_from([1, 2, 3], 0, 2, []) == [1, 2]
  example take_from([1, 2, 3], 0, 0, []) == []
  example take_from([1, 2], 0, 5, []) == [1, 2]
do
  if i >= k then
    return acc
  else
    match list.get(xs, i) do
      case none =>
        return acc
      case some(x) =>
        return take_from(xs, i + 1, k, list.append(acc, x))
    end match
  end if
end fn

fn drop_top(xs: List<Int>, count: Int) -> List<Int>
  intent "xs without its last count items"
  requires count >= 0
  example drop_top([1, 2, 3], 1) == [1, 2]
  example drop_top([1, 2, 3], 2) == [1]
  example drop_top([4], 1) == []
do
  return take_from(xs, 0, list.len(xs) - count, [])
end fn

fn apply_op(op: Text, n: Int, stack: List<Int>) -> Result<List<Int>, Text>
  intent "the stack after one command, or err underflow or err unknown"
  example apply_op("push", 5, [1]) == ok([1, 5])
  example apply_op("add", 0, [1, 2]) == ok([3])
  example apply_op("swap", 0, [1, 2]) == ok([2, 1])
  example apply_op("pop", 0, []) == err("underflow")
  example apply_op("jump", 0, [1]) == err("unknown")
do
  let size = list.len(stack)
  let below = option.unwrap_or(list.get(stack, size - 2), 0)
  let top = option.unwrap_or(list.get(stack, size - 1), 0)
  match op do
    case "push" =>
      return ok(list.append(stack, n))
    case "pop" =>
      if size < 1 then
        return err("underflow")
      else
        return ok(drop_top(stack, 1))
      end if
    case "dup" =>
      if size < 1 then
        return err("underflow")
      else
        return ok(list.append(stack, top))
      end if
    case "add" =>
      if size < 2 then
        return err("underflow")
      else
        return ok(list.append(drop_top(stack, 2), below + top))
      end if
    case "mul" =>
      if size < 2 then
        return err("underflow")
      else
        return ok(list.append(drop_top(stack, 2), below * top))
      end if
    case "swap" =>
      if size < 2 then
        return err("underflow")
      else
        return ok(list.append(list.append(drop_top(stack, 2), top), below))
      end if
    case _ =>
      return err("unknown")
  end match
end fn

fn show_from(xs: List<Int>, i: Int) -> Text
  intent "the items of xs from index i on, written with commas and no spaces"
  requires i >= 0
  example show_from([1, 2, 3], 0) == "1,2,3"
  example show_from([1, 2, 3], 2) == "3"
  example show_from([], 0) == ""
do
  match list.get(xs, i) do
    case none =>
      return ""
    case some(x) =>
      if i + 1 >= list.len(xs) then
        return int.to_text(x)
      else
        return text.concat(int.to_text(x), text.concat(",", show_from(xs, i + 1)))
      end if
  end match
end fn

fn trace_line(pos: Int, stack: List<Int>) -> Text
  intent "the trace line after command pos: its number and the stack, bottom first"
  example trace_line(1, [3]) == "1: [3]"
  example trace_line(2, []) == "2: []"
  example trace_line(3, [2, 0 - 1, 4]) == "3: [2,-1,4]"
do
  return text.concat(int.to_text(pos), text.concat(": [", text.concat(show_from(stack, 0), "]")))
end fn

fn error_text(why: Text, pos: Int) -> Text
  intent "the error message for a failed command"
  example error_text("underflow", 2) == "stack underflow at command 2"
  example error_text("unknown", 1) == "unknown op at command 1"
do
  if why == "underflow" then
    return text.concat("stack underflow at command ", int.to_text(pos))
  else
    return text.concat("unknown op at command ", int.to_text(pos))
  end if
end fn

fn run_from(cmds: List<Cmd>, i: Int, stack: List<Int>) -> Result<List<Int>, Text>
  intent "run the commands from index i on, tracing the stack after each, and return the final stack or the first error"
  uses [console]
  requires i >= 0
  example trace_line(1, [1]) == "1: [1]"
  example error_text("unknown", 4) == "unknown op at command 4"
do
  match list.get(cmds, i) do
    case none =>
      return ok(stack)
    case some(c) =>
      match apply_op(c.op, c.n, stack) do
        case err(why) =>
          return err(error_text(why, i + 1))
        case ok(next) =>
          console.print(trace_line(i + 1, next))
          return run_from(cmds, i + 1, next)
      end match
  end match
end fn

fn run_stack(cmds: List<Cmd>) -> Result<Int, Text>
  intent "run a stack machine over the commands, printing the stack after each one, and return the top of the final stack or an error"
  uses [console]
  example apply_op("push", 1, []) == ok([1])
  example trace_line(1, []) == "1: []"
do
  match run_from(cmds, 0, []) do
    case err(msg) =>
      return err(msg)
    case ok(stack) =>
      match list.get(stack, list.len(stack) - 1) do
        case none =>
          return err("empty stack at end")
        case some(top) =>
          return ok(top)
      end match
  end match
end fn
