fn page_count(n: Int, size: Int) -> Int
  intent "how many pages of the given size are needed for n items"
  requires n >= 0
  requires size >= 1
  ensures out >= 0
  example page_count(5, 2) == 3
  example page_count(4, 2) == 2
  example page_count(0, 3) == 0
do
  return (n + size - 1) / size
end fn

fn header_line(p: Int, q: Int) -> Text
  intent "the header line of page p out of q pages"
  example header_line(1, 3) == "-- page 1 of 3 --"
  example header_line(10, 12) == "-- page 10 of 12 --"
do
  return text.concat("-- page ", text.concat(int.to_text(p), text.concat(" of ", text.concat(int.to_text(q), " --"))))
end fn

fn print_range(items: List<Text>, i: Int, stop: Int) -> Int
  intent "print the items from index i up to but not including index stop, or to the end of the list, and return the index after the last one printed"
  uses [console]
  requires i >= 0
  ensures out >= i
  example header_line(1, 1) == "-- page 1 of 1 --"
  example header_line(2, 5) == "-- page 2 of 5 --"
do
  if i >= stop then
    return i
  else
    match list.get(items, i) do
      case none =>
        return i
      case some(item) =>
        console.print(item)
        return print_range(items, i + 1, stop)
    end match
  end if
end fn

fn pages_from(items: List<Text>, start: Int, size: Int, p: Int, q: Int) -> Int
  intent "print the pages that begin at index start and return how many pages were printed"
  uses [console]
  requires start >= 0
  requires size >= 1
  ensures out >= 0
  example header_line(1, 2) == "-- page 1 of 2 --"
  example header_line(3, 3) == "-- page 3 of 3 --"
do
  if start >= list.len(items) then
    return 0
  else
    console.print(header_line(p, q))
    let next = print_range(items, start, start + size)
    return 1 + pages_from(items, next, size, p + 1, q)
  end if
end fn

fn print_pages(items: List<Text>, size: Int) -> Result<Int, Text>
  intent "print the items in pages of the given size, each page under a header, and return the number of pages or an error for a bad page size"
  uses [console]
  ensures result.is_ok(out) == (size >= 1)
  example page_count(3, 3) == 1
  example page_count(7, 3) == 3
do
  if size < 1 then
    return err("page size must be at least 1")
  else
    if list.len(items) == 0 then
      console.print("(no items)")
      return ok(0)
    else
      let q = page_count(list.len(items), size)
      let pages = pages_from(items, 0, size, 1, q)
      return ok(pages)
    end if
  end if
end fn
