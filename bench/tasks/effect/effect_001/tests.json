[
  {"args": [[]], "expect": 0, "stdout": ""},
  {"args": [["milk"]], "expect": 1, "stdout": "1. milk\n"},
  {"args": [["milk", "eggs", "bread"]], "expect": 3, "stdout": "1. milk\n2. eggs\n3. bread\n"},
  {"args": [["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"]], "expect": 12, "stdout": "1. a\n2. b\n3. c\n4. d\n5. e\n6. f\n7. g\n8. h\n9. i\n10. j\n11. k\n12. l\n"},
  {"args": [["", "x", ""]], "expect": 3, "stdout": "1. \n2. x\n3. \n"},
  {"args": [["same", "same", "same"]], "expect": 3, "stdout": "1. same\n2. same\n3. same\n"},
  {"args": [["a b c", "  lead", "trail  "]], "expect": 3, "stdout": "1. a b c\n2.   lead\n3. trail  \n"},
  {"args": [["3. already numbered", "99 balloons"]], "expect": 2, "stdout": "1. 3. already numbered\n2. 99 balloons\n"},
  {"args": [["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9"]], "expect": 9, "stdout": "1. i1\n2. i2\n3. i3\n4. i4\n5. i5\n6. i6\n7. i7\n8. i8\n9. i9\n"},
  {"args": [["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10"]], "expect": 10, "stdout": "1. i1\n2. i2\n3. i3\n4. i4\n5. i5\n6. i6\n7. i7\n8. i8\n9. i9\n10. i10\n"},
  {"args": [["say \"hi\"", "back\\slash"]], "expect": 2, "stdout": "1. say \"hi\"\n2. back\\slash\n"},
  {"args": [["abcdefghijklmnopqrstuvwxyz0123456789ABCD"]], "expect": 1, "stdout": "1. abcdefghijklmnopqrstuvwxyz0123456789ABCD\n"}
