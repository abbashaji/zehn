fn csv_field_count(line: Text) -> Int
  intent "number of comma-separated fields of a line; an empty line has none"
  ensures out >= 0
  example csv_field_count("") == 0
  example csv_field_count("a,b,c") == 3
  example csv_field_count("a,,b,") == 4
do
  if line == "" then
    return 0
  end if
  return list.len(text.split_on(line, ","))
end fn
