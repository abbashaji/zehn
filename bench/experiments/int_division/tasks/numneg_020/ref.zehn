fn rotate_from(xs: List<Int>, k: Int, p: Int) -> List<Int>
  intent "the rotated list from position p on: position p holds the element that is k places further on, wrapping around"
  requires list.len(xs) > 0
  requires p >= 0
  example rotate_from([1, 2, 3], 1, 0) == [2, 3, 1]
  example rotate_from([1, 2, 3], 1, 2) == [1]
  example rotate_from([1, 2, 3], 1, 3) == []
do
  if p >= list.len(xs) then
    return []
  end if
  let x = option.unwrap_or(list.get(xs, int.rem_euclid(p + k, list.len(xs))), 0)
  return list.concat([x], rotate_from(xs, k, p + 1))
end fn

fn rotate_left(xs: List<Int>, k: Int) -> List<Int>
  intent "xs rotated to the left by k places; a negative k rotates to the right"
  example rotate_left([1, 2, 3, 4], 1) == [2, 3, 4, 1]
  example rotate_left([], 3) == []
do
  if list.len(xs) == 0 then
    return []
  end if
  return rotate_from(xs, k, 0)
end fn
